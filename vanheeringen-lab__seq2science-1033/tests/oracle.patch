+            "--unlock",
+            "--rerun-incomplete",
+            "--keep-going",
+            "--skip-rerun",
+            "--reason",
+            "--dryrun",
+        }
+        # all permutations of the binary flags -n, -r and -k
+        for a in ["r", "n", "k"]:
+            blacklist.add(f"-{a}")
