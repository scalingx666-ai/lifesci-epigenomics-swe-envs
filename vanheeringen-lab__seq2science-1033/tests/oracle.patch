 all rules/logic related to quality control and the final multiQC report should be here.
 """
 
+import itertools
 import glob
 import re
 
@@ -528,22 +529,22 @@ rule multiqc_explain:
         cli_call[1] = "explain"
 
         # remove run specific commands
-        cli_call = [
-            arg
-            for arg in cli_call
-            if arg
-            not in {
-                "--unlock",
-                "--rerun-incomplete",
