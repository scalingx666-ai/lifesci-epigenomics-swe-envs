+    Bind the result as ``progress``, not ``log``:
+    :func:`predict_full_chromosomes_to_anndata` already takes a ``log`` flag.
+    """
+    def progress(message: str) -> None:
+        if show_progress:
+            print(message, file=sys.stderr)
+
+    return progress
