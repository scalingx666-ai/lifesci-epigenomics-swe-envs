+def test_integer_covariance_round_trip_preserves_json(tmp_path):
+    model = hand_gaussian()
+    model.covars_ = np.tile(np.eye(4, dtype=int), (3, 1, 1))
+    original = str(tmp_path / "original.json")
+    restored = str(tmp_path / "restored.json")
