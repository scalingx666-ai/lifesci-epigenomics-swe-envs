+#' Row subsetting for vectors, matrices and data frames.
+#' Replaces \code{grr::extract}, since grr is off CRAN.
+#'
+extract_rows <- function(x, i){
+    if (is.null(dim(x))){
+        return(x[i])
+    }
+    if (is.data.frame(x)){
+        return(as.data.frame(lapply(x, function(a) a[i])))
+    }
+    return(x[i, ])
+}
