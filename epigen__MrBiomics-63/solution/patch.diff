+    #     alpha = 0.5,
+    #     stroke = 0
+    # ) +
+    # axis titles
+    labs(
+    title = paste0(ct,"\n",sprintf("Pearson's R = %.2f", r_val)),
+    x = "Chromatin accessibility\n(normalized & integrated)",
+    y = "Gene expression\n(normalized & integrated)"
+    ) +
+    MrBiomics_theme() + 
+    theme(aspect.ratio = 1)
