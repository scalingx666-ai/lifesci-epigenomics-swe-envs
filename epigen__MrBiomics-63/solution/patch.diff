+build_tf_axis_labels <- function(tfs, papalexi_set, red_set, blue_set) {
+  vapply(tfs, function(tf) {
+    is_pap <- tf %in% papalexi_set
+    in_red <- tf %in% red_set
+    in_blue <- tf %in% blue_set
+
+    if (in_red && in_blue) {
+      col <- violet_col
+    } else if (in_red) {
+      col <- red_col
+    } else if (in_blue) {
+      col <- blue_col
+    } else {
+      col <- NA_character_
+    }
+
+    lab <- tf
+    if (is_pap) {
+      lab <- paste0("<b>", lab, "</b>")
